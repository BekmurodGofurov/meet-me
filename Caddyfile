# Caddy issues and renews real TLS certificates automatically (Let's
# Encrypt) for {$DOMAIN} - no cert files to generate, copy, or trust
# manually, unlike the mkcert setup used for local LAN testing.
#
# Two site blocks sharing one domain: the app's WebSocket URL is hardcoded
# to the page's own hostname on port 8080 (see client/src/hooks/useRoom.js),
# so Caddy fronts that exact port too, reusing the same certificate rather
# than requiring a second domain or a code change.
#
# DOMAIN must be a real DNS name pointing at this server - Let's Encrypt
# cannot issue a certificate for a bare IP address. For a quick test without
# owning a domain yet, replace both {$DOMAIN} lines below with the server's
# IP and add `tls internal` to each block instead - that self-signs (same
# idea as the old mkcert setup), and browsers will need to be told to trust
# it once, just like before.

{$DOMAIN} {
	reverse_proxy client:80
}

{$DOMAIN}:8080 {
	reverse_proxy backend:8080
}
