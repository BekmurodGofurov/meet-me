# ==============================================================================
# Frontend / Client Configuration (Vite)
# ==============================================================================

# WebSocket signaling URL:
# - '/ws' in dev (proxied by Vite) or production (proxied by Nginx)
# - 'ws://localhost:8080/ws' for direct connection
# - 'wss://meet-me.bekmurod.uz/ws' for production HTTPS/WSS
VITE_WS_URL=/ws

# Backend HTTP API URL
VITE_API_URL=http://localhost:8080

# Client secret key (must match backend SECRET_KEY)
VITE_SECRET_KEY=meet-me-secret-key-change-in-production
