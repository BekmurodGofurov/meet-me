# ==============================================================================
# Meet-Me Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Internal port the backend process listens on (default: 8080)
PORT=8080

# Host port for Docker container (mapped to 127.0.0.1:<BACKEND_PORT>:8080)
BACKEND_PORT=8090

# Room deletion grace period in milliseconds when all participants leave (default: 10000)
ROOM_GRACE_MS=10000

# Web origins allowed to open a WebSocket (comma-separated). Empty = any (dev only).
# ALLOWED_ORIGINS=https://meet-me.bekmurod.uz

# 1 when behind nginx, so per-IP rate limits see the real client address
# TRUST_PROXY=1

# Optional own TURN server (coturn, use-auth-secret). Clients get short-lived
# credentials from the backend; TURN_SECRET never reaches the browser.
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------------------------
# Frontend / Client Configuration (Vite)
# ------------------------------------------------------------------------------
# WebSocket signaling URL for client to connect to backend:
# - '/ws' in dev (proxied by Vite) or production (proxied by Nginx)
# - 'ws://localhost:8080/ws' for direct connection
# - 'wss://meet-me.bekmurod.uz/ws' for production HTTPS/WSS
VITE_WS_URL=/ws

# Backend HTTP API URL
VITE_API_URL=http://localhost:8080
