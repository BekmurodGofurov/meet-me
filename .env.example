# ==============================================================================
# Meet-Me Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Internal port the backend process listens on (default: 8080)
PORT=8080

# Host port for Docker container (mapped to 127.0.0.1:<BACKEND_PORT>:8080)
BACKEND_PORT=8090

# Secret key required for WebSocket signaling authorization between client and backend
SECRET_KEY=meet-me-secret-key-change-in-production

# Room deletion grace period in milliseconds when all participants leave (default: 10000)
ROOM_GRACE_MS=10000

# ------------------------------------------------------------------------------
# Frontend / Client Configuration (Vite)
# ------------------------------------------------------------------------------
# WebSocket signaling URL for client to connect to backend:
# - '/ws' in dev (proxied by Vite) or production (proxied by Nginx)
# - 'ws://localhost:8080/ws' for direct connection
# - 'wss://meet-me.bekmurod.uz/ws' for production HTTPS/WSS
VITE_WS_URL=/ws

# Backend HTTP API URL
VITE_API_URL=http://localhost:8080

# Client secret key (must match backend SECRET_KEY)
VITE_SECRET_KEY=meet-me-secret-key-change-in-production
