# A complete, standalone site file for meet-me.bekmurod.uz (a fresh
# subdomain with no existing server block to add onto). If you're instead
# reusing a domain that already has an SSL-terminated block for another
# project, just copy the `location /` and `location /ws` blocks into that
# one - don't create a second server block for the same domain.
#
# Setup, in order:
#   1. sudo nano /etc/nginx/sites-available/meet-me
#      (paste this file, adjusted for your actual paths/port)
#   2. sudo ln -s /etc/nginx/sites-available/meet-me /etc/nginx/sites-enabled/
#   3. sudo nginx -t && sudo systemctl reload nginx
#      -> http://meet-me.bekmurod.uz should now serve the app (plain http)
#   4. sudo apt install certbot python3-certbot-nginx   # if not already installed
#      sudo certbot --nginx -d meet-me.bekmurod.uz
#      -> certbot edits this file in place, adding the SSL block and an
#         http->https redirect, and sets up auto-renewal
#
# Camera/mic access needs a secure context - unlike localhost, a real public
# domain over plain http does NOT count, so step 4 is not optional here.

server {
    listen 80;
    server_name meet-me.bekmurod.uz;

    root /var/www/meet-me-frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # WebSocket signaling - same origin/domain as the frontend, no separate
    # public port needed. The Upgrade/Connection headers are what make this
    # a WebSocket proxy instead of a normal HTTP one.
    location /ws {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # WebRTC signaling messages are small but the connection is
        # long-lived - without this nginx closes "idle" connections well
        # before the call actually ends.
        proxy_read_timeout 3600s;
    }
}
