# ==============================================================================
# Backend Signaling Server Configuration
# ==============================================================================

# Internal port the backend process listens on
PORT=8080

# Room deletion grace period in milliseconds when all participants leave
ROOM_GRACE_MS=10000

# Comma-separated list of web origins allowed to open a WebSocket.
# Empty = allow any origin (local development only).
# ALLOWED_ORIGINS=https://meet-me.bekmurod.uz

# Set to 1 when running behind a reverse proxy you control (nginx) that sets
# X-Forwarded-For, so per-IP rate limits see the real client address.
# TRUST_PROXY=1

# STUN servers (comma-separated). Default: stun:stun.l.google.com:19302
# STUN_URLS=stun:stun.l.google.com:19302

# Your own TURN server (coturn with "use-auth-secret"). The backend hands each
# client short-lived credentials derived from TURN_SECRET - the secret itself
# never reaches the browser.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=change-me-to-a-long-random-string
# TURN_TTL_SECONDS=3600
